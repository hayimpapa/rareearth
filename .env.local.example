ANTHROPIC_API_KEY=your_key_here
PORT=3000

# Shared secret required on every /analyze request as the `x-api-key` header.
# Generate one with: openssl rand -hex 32
ANALYZE_TOKEN=

# Set to 0.0.0.0 only if you intentionally want the endpoint reachable from
# outside this machine. Defaults to 127.0.0.1 (loopback only) for safety.
HOST=127.0.0.1
